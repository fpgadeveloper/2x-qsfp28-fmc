-		 * HSE_BAD_CODE_WINDOW_US, a fresh short window for the error
-		 * counts, so that errors from before alignment do not count.
-		 */
-		axienet_iow(lp, HSE_LETH_TICK_OFFSET, HSE_TICK_TRIGGER);
-		smp->rx_good = axienet_hse_count(lp,
-						 HSE_LETH_STAT_RX_GOOD_OFFSET);
+	if (!lp->hse_leth)
+		return ok;
+
+	/* Statistics are per-tick counts, latched and restarted by each
+	 * TICK_REG write (MODE_REG tick_reg_mode_sel = 1). The first window
+	 * runs since the previous sample (good frames for the wedge check);
+	 * the second, HSE_BAD_CODE_WINDOW_US long, gives fresh error counts,
+	 * so that errors from before alignment do not count. Both windows are
+	 * added to the hse_mac_rx_* counters.
+	 */
+	smp->rx_good = axienet_hse_stat_window(lp);
+	if (ok) {
 		usleep_range(HSE_BAD_CODE_WINDOW_US,
 			     HSE_BAD_CODE_WINDOW_US + 1000);
-		axienet_iow(lp, HSE_LETH_TICK_OFFSET, HSE_TICK_TRIGGER);
-		smp->bad_code = axienet_hse_count(lp,
-						  HSE_LETH_STAT_BAD_CODE_OFFSET);
-		for (l = 0; l < 4; l++)
