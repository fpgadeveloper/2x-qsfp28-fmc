--- a/drivers/net/ethernet/xilinx/xilinx_axienet.h
+++ b/drivers/net/ethernet/xilinx/xilinx_axienet.h
@@ -517,7 +517,14 @@ enum temac_stat {
 #define HSE_LETH_BLOCK_LOCK_MASK	0xF	/* 4 PCS lanes */
 #define HSE_LETH_STAT_BIP_ERR_OFFSET(l)	(0x00000508 + 8 * (l))	/* LSB, lane 0-3 */
 #define HSE_LETH_STAT_BAD_CODE_OFFSET	0x00000660	/* per-tick count, LSB */
+#define HSE_LETH_STAT_RX_TOTAL_OFFSET	0x00000808	/* per-tick count, LSB */
 #define HSE_LETH_STAT_RX_GOOD_OFFSET	0x00000810	/* per-tick count, LSB */
+#define HSE_LETH_STAT_RX_FRAGMENT_OFFSET	0x000008A0
+#define HSE_LETH_STAT_RX_BAD_FCS_OFFSET	0x000008C0
+#define HSE_LETH_STAT_RX_STOMPED_OFFSET	0x000008D0
+#define HSE_LETH_STAT_RX_TRUNCATED_OFFSET	0x00000910
+/* per-tick statistics are 48 bit: LSB at the offset, MSB[15:0] at +4 */
+#define HSE_LETH_STAT_MSB		0x00000004
 #define HSE_LETH_STAT_TIMEOUT		0xBADBAD00	/* read timed out in-core */
 
 #define HSE_RX_STATUS_MASK	BIT(0)	/* stat_rx_status */
@@ -555,6 +562,13 @@ enum temac_stat {
  * disturb the partner's healthy RX
  */
 #define HSE_LINK_NOSIG_RETRY_MS	1000
+#define HSE_LINK_NOSIG_SLOW_MS	2000	/* after HSE_NOSIG_SLOW_AFTER attempts */
+#define HSE_NOSIG_SLOW_AFTER	10
+/* After each recovery reset, the latched-low RX status / block lock are
+ * flushed HSE_LINK_ARM_MS later, so the interval judged at the next sample
+ * starts after the reset has completed.
+ */
+#define HSE_LINK_ARM_MS		100
 
 /* HSE link monitor statistics ("ethtool -S", after rx_dma_pkt_drop) */
 enum axienet_hse_stat {
@@ -565,8 +579,20 @@ enum axienet_hse_stat {
 	HSE_STAT_GT_RX_RESETS,		/* recovery: GT RX datapath reset */
 	HSE_STAT_GT_RESET_ALLS,		/* recovery: GT reset-all */
 	HSE_STAT_WEDGE_RESTARTS,	/* RX wedge: interface restarted */
+	/* l_ethernet only: the MAC's own per-tick RX statistics, summed over
+	 * every monitor TICK window into 64-bit counters (kept across down/up)
+	 */
+	HSE_STAT_MAC_RX_TOTAL,
+	HSE_STAT_MAC_RX_GOOD,
+	HSE_STAT_MAC_RX_BAD_FCS,
+	HSE_STAT_MAC_RX_STOMPED,
+	HSE_STAT_MAC_RX_FRAGMENT,
+	HSE_STAT_MAC_RX_TRUNCATED,
+	HSE_STAT_MAC_RX_BAD_CODE,
 	HSE_STAT_NUM
 };
+
+#define HSE_STAT_MON_NUM	HSE_STAT_MAC_RX_TOTAL	/* CMAC: monitor counters only */
 /* Switchable 1/10/25G MAC Register Definitions */
 #define XXVS_RESET_OFFSET		0x00000004
 #define XXVS_AN_CTL1_OFFSET		0x000000e0
@@ -1166,8 +1192,13 @@ struct axienet_local {
 	unsigned int hse_link_bad;
 	unsigned int hse_link_resets;
 	unsigned int hse_rx_fails;
+	unsigned int hse_nosig;
+	unsigned int hse_arm_rest;
+	bool hse_arm;
+	bool hse_int_valid;
 	unsigned long hse_bad_since;
 	u64 hse_stats[HSE_STAT_NUM];
+	u64 rx_dma_pktdrop_acc;
 	unsigned int hse_wedge;
 	unsigned long hse_rx_seen;
 	unsigned long hse_restart_at;
