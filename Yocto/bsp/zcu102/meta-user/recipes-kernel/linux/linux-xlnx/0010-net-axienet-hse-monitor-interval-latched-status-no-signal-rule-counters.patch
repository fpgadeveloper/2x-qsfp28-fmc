-	u32 rx_good;	/* good frames since the previous sample's window */
+	u32 rx_good;	/* good frames since the previous statistics TICK */
 };
 
 static u32 axienet_hse_count(struct axienet_local *lp, u32 off)
@@ -1129,6 +1127,58 @@ static u32 axienet_hse_count(struct axienet_local *lp, u32 off)
 	return val == HSE_LETH_STAT_TIMEOUT ? 0 : val;
 }
 
+/* One 48-bit per-tick statistics counter (0 if the read timed out) */
+static u64 axienet_hse_stat48(struct axienet_local *lp, u32 off)
+{
+	u32 lo = axienet_ior(lp, off);
+	u32 hi = axienet_ior(lp, off + HSE_LETH_STAT_MSB);
+
+	if (lo == HSE_LETH_STAT_TIMEOUT || hi == HSE_LETH_STAT_TIMEOUT)
+		return 0;
+	return ((u64)(hi & 0xffff) << 32) | lo;
+}
+
+/* Close the current statistics window (TICK) and add the MAC's RX counts
+ * to the 64-bit ethtool counters; returns the window's good frames.
+ */
+static u32 axienet_hse_stat_window(struct axienet_local *lp)
+{
+	static const u16 off[] = {
+		[HSE_STAT_MAC_RX_TOTAL - HSE_STAT_MAC_RX_TOTAL] =
+			HSE_LETH_STAT_RX_TOTAL_OFFSET,
+		[HSE_STAT_MAC_RX_GOOD - HSE_STAT_MAC_RX_TOTAL] =
+			HSE_LETH_STAT_RX_GOOD_OFFSET,
+		[HSE_STAT_MAC_RX_BAD_FCS - HSE_STAT_MAC_RX_TOTAL] =
+			HSE_LETH_STAT_RX_BAD_FCS_OFFSET,
+		[HSE_STAT_MAC_RX_STOMPED - HSE_STAT_MAC_RX_TOTAL] =
+			HSE_LETH_STAT_RX_STOMPED_OFFSET,
+		[HSE_STAT_MAC_RX_FRAGMENT - HSE_STAT_MAC_RX_TOTAL] =
+			HSE_LETH_STAT_RX_FRAGMENT_OFFSET,
+		[HSE_STAT_MAC_RX_TRUNCATED - HSE_STAT_MAC_RX_TOTAL] =
+			HSE_LETH_STAT_RX_TRUNCATED_OFFSET,
+		[HSE_STAT_MAC_RX_BAD_CODE - HSE_STAT_MAC_RX_TOTAL] =
+			HSE_LETH_STAT_BAD_CODE_OFFSET,
+	};
+	u64 good = 0, v;
+	unsigned int i;
+
+	axienet_iow(lp, HSE_LETH_TICK_OFFSET, HSE_TICK_TRIGGER);
+	for (i = 0; i < ARRAY_SIZE(off); i++) {
+		v = axienet_hse_stat48(lp, off[i]);
+		lp->hse_stats[HSE_STAT_MAC_RX_TOTAL + i] += v;
+		if (HSE_STAT_MAC_RX_TOTAL + i == HSE_STAT_MAC_RX_GOOD)
+			good = v;
+	}
+	return min_t(u64, good, U32_MAX);
+}
+
+/* The RX status (and, on l_ethernet, block lock) registers are latched-low
+ * and cleared on read. The FIRST read of a sample returns whether the RX
+ * was good during the WHOLE interval since the previous sample's reads;
+ * the second read returns the current state. The monitor is the only
+ * reader of these registers; the interval is meaningful only when
+ * lp->hse_int_valid (no reset of ours inside it).
+ */
 static bool axienet_hse_link_sample(struct axienet_local *lp,
 				    struct axienet_hse_sample *smp)
 {
@@ -1138,27 +1188,33 @@ static bool axienet_hse_link_sample(struct axienet_local *lp,
 	bool ok;
 
 	memset(smp, 0, sizeof(*smp));
-	axienet_ior(lp, off);		/* flush the latched-low history */
+	smp->sts_int = axienet_ior(lp, off);
 	smp->sts = axienet_ior(lp, off);
+	if (lp->hse_leth) {
+		smp->blk_int = axienet_ior(lp, HSE_LETH_STAT_BLOCK_LOCK_OFFSET);
+		smp->blk = axienet_ior(lp, HSE_LETH_STAT_BLOCK_LOCK_OFFSET);
+	}
 	ok = (smp->sts & HSE_RX_STATUS_MASK) && (smp->sts & HSE_RX_ALIGNED_MASK);
 
-	if (ok && lp->hse_leth) {
-		/* Statistics are per-tick counts, latched and restarted by
-		 * each TICK_REG write (MODE_REG tick_reg_mode_sel = 1). The
