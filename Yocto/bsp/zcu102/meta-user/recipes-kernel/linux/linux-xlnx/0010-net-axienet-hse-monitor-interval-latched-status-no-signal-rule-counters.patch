+		lp->hse_nosig++;
 		axienet_hse_reset_rx(lp);
-		return lp->hse_link_resets <= HSE_RX_ONLY_RESETS ?
-		       HSE_LINK_RETRY_MS : HSE_LINK_NOSIG_RETRY_MS;
+		if (lp->hse_nosig > HSE_NOSIG_SLOW_AFTER)
+			delay = HSE_LINK_NOSIG_SLOW_MS;
+		else if (lp->hse_nosig > HSE_RX_ONLY_RESETS)
+			delay = HSE_LINK_NOSIG_RETRY_MS;
