+			    what, smp->sts_int, smp->sts, lp->hse_link_resets);
 }
 
 static void axienet_hse_reset_all(struct axienet_local *lp)
@@ -1254,38 +1309,61 @@ static void axienet_hse_reset_rx(struct axienet_local *lp)
 	lp->hse_stats[HSE_STAT_GT_RX_RESETS]++;
 }
 
-/* One recovery step while the link is down; returns the delay until the
- * next sample in ms.
+/* One recovery step while the link is down, judged from the interval since
+ * the previous sample (int_ok: that interval started after our last reset
+ * had completed). Returns the delay until the next monitor run in ms.
+ *
+ * l_ethernet:
+ *  - GTWIZ TX/RX reset done not both set (PLL / refclk not up): reset-all.
+ *  - "signal usable" = ALL four lanes block-locked AND the RX aligned
+ *    continuously over the whole interval (latched-low reads). A dark
+ *    receiver can show momentary block lock on some lanes, so anything
+ *    less counts as no usable signal: GT RX datapath reset only, with
+ *    back-off (500 ms x3, then 1 s, then 2 s after 10 attempts), never a
+ *    reset-all - restarting our TX would disturb the partner's healthy RX.
+ *  - signal usable but the RX still not good (e.g. aligned while decoding
+ *    garbage): RX-only reset, and a reset-all after HSE_RX_ONLY_RESETS of
+ *    them in a row failed.
+ * CMAC: reset-all (the only GT reset its register map has).
+ * After every reset the latched registers are flushed HSE_LINK_ARM_MS
+ * later, so that the next interval judged starts after the reset.
  */
-static unsigned int axienet_hse_recover(struct axienet_local *lp)
+static unsigned int axienet_hse_recover(struct axienet_local *lp,
+					const struct axienet_hse_sample *smp,
+					bool int_ok)
 {
-	u32 gt, blk;
+	u32 lock = HSE_LETH_BLOCK_LOCK_MASK;
+	unsigned int delay = HSE_LINK_RETRY_MS;
+	u32 gt;
 
 	lp->hse_link_resets++;
 	if (!lp->hse_leth) {
 		axienet_hse_reset_all(lp);
-		return HSE_LINK_RETRY_MS;
+		goto arm;
 	}
 
 	gt = axienet_ior(lp, HSE_LETH_GTWIZ_DONE_OFFSET);
 	if ((gt & HSE_LETH_GTWIZ_DONE_MASK) != HSE_LETH_GTWIZ_DONE_MASK) {
-		/* GT itself not up (PLL / refclk): only a reset-all helps */
 		lp->hse_rx_fails = 0;
+		lp->hse_nosig = 0;
 		axienet_hse_reset_all(lp);
-		return HSE_LINK_RETRY_MS;
+		goto arm;
 	}
 
-	axienet_ior(lp, HSE_LETH_STAT_BLOCK_LOCK_OFFSET);	/* latched-low */
-	blk = axienet_ior(lp, HSE_LETH_STAT_BLOCK_LOCK_OFFSET);
-	if (blk == HSE_LETH_STAT_TIMEOUT || !(blk & HSE_LETH_BLOCK_LOCK_MASK)) {
-		/* No signal: RX-only, backing off, never a reset-all */
+	if (!int_ok || (smp->blk_int & lock) != lock ||
+	    !(smp->sts_int & HSE_RX_ALIGNED_MASK)) {
+		/* No usable signal: RX-only, backing off, never a reset-all */
