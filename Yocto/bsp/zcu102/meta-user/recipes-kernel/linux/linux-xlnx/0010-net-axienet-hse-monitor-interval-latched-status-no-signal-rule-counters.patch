 static void axienet_hse_link_poll(struct work_struct *work)
 {
 	struct axienet_local *lp = container_of(work, struct axienet_local,
 						hse_link_work.work);
+	u32 good = HSE_RX_STATUS_MASK | HSE_RX_ALIGNED_MASK;
 	struct net_device *ndev = lp->ndev;
 	struct axienet_hse_sample smp;
 	unsigned int delay_ms;
+	bool int_ok;
+
+	if (lp->hse_arm) {
+		/* Start a clean latched interval after our own reset */
+		axienet_ior(lp, lp->hse_leth ? HSE_LETH_STAT_RX_STATUS_OFFSET
+					     : HSE_CMAC_STAT_RX_STATUS_OFFSET);
+		if (lp->hse_leth)
+			axienet_ior(lp, HSE_LETH_STAT_BLOCK_LOCK_OFFSET);
+		lp->hse_arm = false;
+		lp->hse_int_valid = true;
+		delay_ms = lp->hse_arm_rest;
+		goto out;
+	}
 
+	int_ok = lp->hse_int_valid;
 	if (axienet_hse_link_sample(lp, &smp)) {
+		lp->hse_int_valid = true;
 		if (!netif_carrier_ok(ndev)) {
 			netif_carrier_on(ndev);
 			netdev_info(ndev, "HSE MAC link up at %d Mbps (%u recovery resets)\n",
 				    lp->max_speed, lp->hse_link_resets);
 			lp->hse_link_resets = 0;
 			lp->hse_rx_fails = 0;
+			lp->hse_nosig = 0;
 		} else {
-			if (lp->hse_link_bad && net_ratelimit())
-				netdev_info(ndev, "HSE RX recovered after %u bad sample(s) in %u ms, carrier kept\n",
-					    lp->hse_link_bad,
-					    jiffies_to_msecs(jiffies - lp->hse_bad_since));
+			if (lp->hse_link_bad) {
+				if (net_ratelimit())
+					netdev_info(ndev, "HSE RX recovered after %u bad sample(s) in %u ms, carrier kept\n",
+						    lp->hse_link_bad,
+						    jiffies_to_msecs(jiffies - lp->hse_bad_since));
+			} else if (int_ok &&
+				   ((smp.sts_int & good) != good ||
+				    (lp->hse_leth &&
+				     (smp.blk_int & HSE_LETH_BLOCK_LOCK_MASK) !=
+				     HSE_LETH_BLOCK_LOCK_MASK))) {
+				/* Lost and regained between two samples */
