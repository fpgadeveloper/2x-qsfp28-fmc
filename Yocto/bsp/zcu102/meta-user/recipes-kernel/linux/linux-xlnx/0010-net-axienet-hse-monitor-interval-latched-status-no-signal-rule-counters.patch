+		axienet_hse_stat_window(lp);
+		smp->bad_code = lp->hse_stats[HSE_STAT_MAC_RX_BAD_CODE] -
+				smp->bad_code;
+		for (l = 0; l < 4; l++)		/* same (short) TICK window */
 			smp->bip_max = max(smp->bip_max,
 					   axienet_hse_count(lp, HSE_LETH_STAT_BIP_ERR_OFFSET(l)));
 		if (smp->bad_code > HSE_BAD_CODE_LIMIT ||
@@ -1223,17 +1279,16 @@ static void axienet_hse_link_log(struct axienet_local *lp, const char *what,
 {
 	if (lp->hse_leth)
 		netdev_warn(lp->ndev,
-			    "HSE MAC %s (rx_sts 0x%x gt_done 0x%x blk_lck 0x%x lane_sync 0x%x sts1 0x%x bad_code %u bip_max %u, %u recovery resets)\n",
-			    what, smp->sts,
+			    "HSE MAC %s (rx_sts 0x%x/0x%x blk_lck 0x%x/0x%x (interval/now) gt_done 0x%x lane_sync 0x%x sts1 0x%x bad_code %u bip_max %u, %u recovery resets)\n",
+			    what, smp->sts_int, smp->sts, smp->blk_int, smp->blk,
 			    axienet_ior(lp, HSE_LETH_GTWIZ_DONE_OFFSET),
-			    axienet_ior(lp, HSE_LETH_STAT_BLOCK_LOCK_OFFSET),
 			    axienet_ior(lp, HSE_LETH_STAT_LANE_SYNC_OFFSET),
