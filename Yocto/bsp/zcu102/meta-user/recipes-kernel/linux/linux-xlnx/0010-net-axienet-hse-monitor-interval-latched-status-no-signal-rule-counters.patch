-	/* Signal present, RX not working */
+	lp->hse_nosig = 0;
 	if (lp->hse_rx_fails < HSE_RX_ONLY_RESETS) {
 		lp->hse_rx_fails++;
 		axienet_hse_reset_rx(lp);
@@ -1293,29 +1371,62 @@ static unsigned int axienet_hse_recover(struct axienet_local *lp)
 		lp->hse_rx_fails = 0;
 		axienet_hse_reset_all(lp);
