# 2x QSFP28 FMC overrides for zcu208 (ZynqMP), EDF flow.
# bsp/zcu208 gets its own MACHINE/SDT from its own Vivado XSA via
# gen-machineconf parse-sdt (PS + PL device tree derived from hardware);
# MACHINE is NOT pinned. Console comes from the SDT. Bump CMA if a target
# needs larger DMA buffers.
APPEND:append = " earlycon clk_ignore_unused rw rootwait cma=512M"

# Hostname (overrides amd-edf default of "amd-edf").
hostname:pn-base-files = "zcu208-qsfp-2025-2"

# Reserve space in the rootfs for image-time installs.
IMAGE_ROOTFS_EXTRA_SPACE = "524288"
